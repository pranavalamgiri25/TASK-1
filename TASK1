    "import re\n",
    "import secrets\n",
    "import string\n",
    "\n",
    "COMMON_PASSWORDS = {\"password\", \"123456\", \"password123\", \"admin\", \"qwerty\"}\n",
    "\n",
    "\n",
    "def analyze_password(pwd: str) -> dict:\n",
    "    feedback = []\n",
    "    score = 0\n",
    "\n",
    "    # 1. Check against common dictionary\n",
    "    if pwd.lower() in COMMON_PASSWORDS:\n",
    "        return {\"score\": 0, \"status\": \"Very Weak\", \"feedback\": [\"Common password detected.\"]}\n",
    "\n",
    "    # 2. Length check\n",
    "    if len(pwd) >= 12:\n",
    "        score += 2\n",
    "    elif len(pwd) >= 8:\n",
    "        score += 1\n",
    "    else:\n",
    "        feedback.append(\"Increase length to at least 8 (ideally 12+) characters.\")\n",
    "\n",
    "    # 3. Complexity checks\n",
    "    if re.search(r\"[a-z]\", pwd):\n",
    "        score += 1\n",
    "    else:\n",
    "        feedback.append(\"Include at least one lowercase letter.\")\n",
    "\n",
    "    if re.search(r\"[A-Z]\", pwd):\n",
    "        score += 1\n",
    "    else:\n",
    "        feedback.append(\"Include at least one uppercase letter.\")\n",
    "\n",
    "    if re.search(r\"\\d\", pwd):\n",
    "        score += 1\n",
    "    else:\n",
    "        feedback.append(\"Include at least one number.\")\n",
    "\n",
    "    if re.search(r'[!@#$%^&*(),.?\":{}|<>]', pwd):\n",
    "        score += 1\n",
    "    else:\n",
    "        feedback.append(\"Include at least one special character.\")\n",
    "\n",
    "    # Rating based on score (max 6)\n",
    "    if score <= 2:\n",
    "        status = \"Weak\"\n",
    "    elif score <= 4:\n",
    "        status = \"Medium\"\n",
    "    else:\n",
    "        status = \"Strong\"\n",
    "\n",
    "    return {\"score\": score, \"status\": status, \"feedback\": feedback}"
   ]
  },
